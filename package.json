{
  "name": "mcp-generate-okrs-ppm",
  "version": "1.0.1",
  "description": "MCP server that generates consolidated OKR reports in Excel",
  "main": "dist/index.js",
  "bin": {
    "mcp-generate-okrs-ppm": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run __tests__",
    "typecheck": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathannavasppm/mcp-generate-okrs-ppm.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "okr",
    "excel",
    "jira",
    "uptimerobot",
    "npm-audit"
  ],
  "author": "frontend-chapter-devs",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/jonathannavasppm/mcp-generate-okrs-ppm/issues"
  },
  "homepage": "https://github.com/jonathannavasppm/mcp-generate-okrs-ppm#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.2",
    "exceljs": "^4.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
